# SkyKin internal AI — transcription + evaluation scoring
# Install on PBX:
#   sudo mkdir -p /etc/skykin
#   sudo cp scripts/ai.env.example /etc/skykin/ai.env
#   sudo nano /etc/skykin/ai.env
#   sudo chmod 600 /etc/skykin/ai.env

# on | off
SKYKIN_AI=on

# skykin = one POST to your model: file → transcript + scores + notes
# openai_compat = /audio/transcriptions then /chat/completions (local Whisper + LLM gateway)
SKYKIN_AI_MODE=skykin

# Your internal model base URL (no trailing slash)
SKYKIN_AI_BASE_URL=http://127.0.0.1:8100

# Paths on that service
SKYKIN_AI_EVAL_PATH=/v1/evaluate
SKYKIN_AI_TRANSCRIBE_PATH=/v1/audio/transcriptions
SKYKIN_AI_CHAT_PATH=/v1/chat/completions

# Model names your service expects
SKYKIN_AI_MODEL=skykin-qa
SKYKIN_AI_WHISPER_MODEL=whisper

# Optional bearer token (leave empty if LAN-only / no auth)
# SKYKIN_AI_API_KEY=
# SKYKIN_AI_REQUIRE_KEY=false

SKYKIN_AI_TIMEOUT=180

# --- Expected response from SKYKIN_AI_MODE=skykin  POST /v1/evaluate ---
# multipart: file=<recording>, meta=<json>, task=evaluation
# JSON:
# {
#   "ok": true,
#   "transcript": "...",
#   "scores": {
#     "greeting": 4, "knowledge": 3, "resolution": 4,
#     "tone": 5, "procedure": 3, "closing": 4
#   },
#   "notes": "short QA notes"
# }
